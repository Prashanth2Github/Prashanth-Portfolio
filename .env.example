# Copy to .env.local (never committed) and fill in. On Vercel/Netlify, add these in the project's
# Environment Variables settings instead. These are SERVER-ONLY — never prefix them with NEXT_PUBLIC_.

# Contact form → email delivery via Resend (https://resend.com/api-keys). Required for the form to send.
RESEND_API_KEY=

# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=bonkuruprashanth05@gmail.com

# Sender address. Leave empty to use Resend's test sender (onboarding@resend.dev), which only delivers
# to the email address that owns your Resend account. After verifying your own domain in Resend,
# set something like: Portfolio Contact <contact@your-domain.com>
CONTACT_FROM_EMAIL=

# Public site URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=
